@startuml seq-dlq
!theme plain

title DLQ: Processing Flow

participant "Kafka\n{topic}.dlq" as dlq
participant "Cron Job" as cron
participant "Kafka\n{topic}" as kafka
actor "Engineer" as eng

== Alert ==

dlq -> eng: Alert: dlq_messages_total > 0

alt Auto-retry (callbacks.received, merchant.callbacks)

    cron -> dlq: Read messages
    dlq --> cron: {messages}
    cron -> kafka: Republish to original topic

    note over cron: callbacks.received: every 1h\nmerchant.callbacks: every 15m

else Manual review (all others)

    activate eng
    eng -> dlq: Read message
    dlq --> eng: {message, error}
    eng -> eng: Analyze root cause, fix bug
    deactivate eng

    note over dlq
      Message stays in DLQ
      Auto-deleted after retention (7 days)
    end note

end

@enduml
