@startuml seq-dlq
!theme plain

title DLQ: Manual Review Flow

participant "Kafka\n{topic}.dlq" as dlq
actor "Engineer" as eng

note over dlq
  Consumer couldn't process message
  after Kafka retry policy (3 attempts)
end note

== Alert ==

dlq -> eng: Alert: dlq_messages_total > 0

== Investigation ==

activate eng

eng -> dlq: Read message
dlq --> eng: {message, error}

eng -> eng: Analyze root cause, fix bug in code

note over dlq
  Message stays in DLQ
  Auto-deleted after retention (7 days)
end note

deactivate eng

@enduml
